# =============================================================
# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.
# =============================================================

# Groq - https://console.groq.com
# Powers both the feedback report (chat completion) and the speech
# timing analysis (Whisper transcription with word-level timestamps).
GROQ_API_KEY=

# Optional: override the feedback model. Groq retires models periodically,
# so set this if the default becomes unavailable. Current list:
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Tavus - https://tavus.io
# Powers the live conversational video session and the camera-based
# presence analysis.
TAVUS_API_KEY=

# The replica (the AI partner's face). Stock replicas are available to
# every account; "node setup-tavus.js" lists the current options.
TAVUS_REPLICA_ID=

# Personas define how the AI partner behaves. Both are created by
# "node setup-tavus.js", which prints the ids to paste here.
#
# Personas belong to the account that created them, so these must be
# regenerated whenever TAVUS_API_KEY changes. A persona without a
# perception layer produces an empty presence section in the report;
# the server verifies this at startup.
TAVUS_PERSONA_ID=
# Used only by the Business Presentation scenario, which requires an
# audience that stays quiet while the user holds the floor.
TAVUS_PRESENTATION_PERSONA_ID=
# persona for the hiring scenario
TAVUS_HIRE_PERSONA_ID=

# Maximum length of a single session, in seconds. Conversational video
# is billed per minute, so this is the primary cost control.
TAVUS_MAX_CALL_SECONDS=300

# Same cap for the demo tier (ACCESS_CODE_DEMO), which is our own demos rather
# than a prospect — 5 minutes is too short to show the product. Leave blank to
# fall back to the shared cap above.
TAVUS_MAX_CALL_SECONDS_DEMO=1800

# Billing begins when a conversation is created, not when the user joins.
# These cap the exposure if a user never arrives, or closes the tab mid-call.
TAVUS_ABSENT_TIMEOUT=90
TAVUS_LEFT_TIMEOUT=15

# Optional: public URL for Tavus webhooks. Not required - the server
# also fetches the transcript on demand when a session ends.
TAVUS_CALLBACK_URL=

# =============================================================
# ACCESS GATE
# -------------------------------------------------------------
# The site is public, but the trial is not: every live call spends Tavus
# minutes and Groq tokens. Visitors must type one of these codes before
# they can reach the product.
#
# The codes are compared case-insensitively with surrounding whitespace
# trimmed, so a code read off a slide still works. They stay on the
# server and are never sent to the browser.
#
# If NEITHER code is set the trial is closed to everyone — the server
# says so loudly at boot.
# =============================================================

# Full report, no run cap. For our own demos. Shared and reusable.
ACCESS_CODE_DEMO=

# ONE-TIME codes for prospects — the intended way to run the trial.
# Comma separated; case, spaces and dashes are ignored when matching.
#
# Issue a batch of 25:
#   node -e "for(let i=0;i<25;i++)console.log('QFWORK-TRIAL-'+require('crypto').randomBytes(3).toString('hex'))"
#
# Each code carries its own run counter, so a reload, a private tab or a
# second device all present the same spent code and are refused. Send one
# per prospect. A recipient can also be linked straight in with
# https://your-host/exam.html?code=QFWORK-TRIAL-a308b5 which fills the gate
# in for them — worth doing, since most will open it on a phone.
ACCESS_CODES_TRIAL=

# DEPRECATED: the older shared code for prospects. Still honoured so nothing
# breaks mid-flight, but its cap is counted per browser session, so anyone
# who opens a private tab gets another run. Prefer ACCESS_CODES_TRIAL and
# leave this blank.
ACCESS_CODE_SALES=

# Live calls allowed, per tier. Counted on the server at the moment a Tavus
# conversation is created, so reloading the page cannot reset it. For a
# one-time code this is the budget for the CODE; for the shared codes above
# it is per browser session. Blank or 0 means unlimited.
TRIAL_RUNS_DEMO=0
TRIAL_RUNS_SALES=1

# LEGACY: the spent-code tally used to live in this JSON file. It is now kept
# in the database (below); on first boot an existing file is imported once,
# so codes spent before the move stay spent. Leave blank unless the old file
# was somewhere other than trial-codes-used.json next to server.js.
TRIAL_CODES_STATE=

# Where the email → code mapping is kept. Defaults to
# trial-codes-issued.json next to server.js. Point it at a mounted
# volume (e.g. /data/trial-codes-issued.json) if you want the mapping
# to survive redeploys.
TRIAL_CODES_ISSUED_STATE=

# Booking link shown on the report and after a spent trial — the free
# consultation where a recruitment expert reviews the results. Leave it
# blank and the booking card is hidden rather than linking nowhere.
CALENDLY_URL=

# Booking link shown on book.html before users get the code for a trial
# Leave it blank will cause booking not available on book.html.
CALENDLY_URL_TRIAL=

# =============================================================
# DATABASE
# -------------------------------------------------------------
# Spent trial codes, paid codes and their balances, and checkout orders.
#
# Production: a Neon Postgres connection string (neon.tech → your project →
# Connect). Use the "main" branch for the live site and a separate "dev"
# branch for local testing, so tests never touch real customers' data.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Blank: a local PGlite database (real Postgres, in-process) under .data/.
# Fine for development. NOT durable on Railway or Render, whose disk is wiped on every
# deploy — so the server refuses to take payments on it in production.
# =============================================================
DATABASE_URL=

# Optional: where the local PGlite database lives when DATABASE_URL is blank.
PGLITE_DIR=

# =============================================================
# PAYMENTS — weekly subscription
# -------------------------------------------------------------
# Subscribing mints an access code (full report, weekly practice minutes) that is
# shown on screen and emailed. Blank PAYMENT_PROVIDER = subscriptions off and
# the pricing section hidden.
#
#   stripe → Stripe Checkout (cards, Apple Pay, Google Pay). The product and
#            prices are created in Stripe automatically — nothing to set up
#            in the Dashboard except the Customer Portal and, for live, the
#            webhook endpoint.
#   mock   → PLACEHOLDER: a fake checkout page with Pay / Cancel. No money
#            moves. Refused in production unless ALLOW_MOCK_PAYMENTS=true.
# =============================================================
PAYMENT_PROVIDER=
ALLOW_MOCK_PAYMENTS=

# Stripe secret key: sk_test_… locally, sk_live_… in production.
PAYMENT_API_KEY=
# Webhook signing secret (whsec_…).
#   Local: run `stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.expired,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to localhost:3000/api/payments/webhook`
#          and paste the secret it prints.
#   Live:  Dashboard → Developers → Webhooks → add https://<your-domain>/api/payments/webhook
#          with the same events, then copy its signing secret.
PAYMENT_WEBHOOK_SECRET=

# The plan. PLACEHOLDERS — change any time; Stripe prices update themselves
# and existing subscribers keep the price they signed up at.
SUB_OFFER_PRICE=38          # launch-offer price per week
SUB_REGULAR_PRICE=58        # price per week once the offer has expired
SUB_CURRENCY=HKD
SUB_MINUTES_PER_WEEK=10     # practice minutes per week; 0 = unlimited
SUB_SESSIONS_PER_WEEK=0     # sessions per week; 0 = as many as they like
# How long the launch offer lasts, and when it starts:
#   view → when a visitor first sees the pricing
#   link → only via links from POST /api/admin/offer-link (24h from creation)
OFFER_HOURS=24
OFFER_START=view
# Free 1-on-1 coaching for the first N subscribers, and the booking link
# they get (falls back to CALENDLY_URL).
COACHING_SLOTS=30
COACHING_URL=

# Per-call cap for subscribers. Blank: one call may use the whole weekly
# budget. Either way a call is cut off when the week's minutes run out, and
# only the time actually used is charged against them.
TAVUS_MAX_CALL_SECONDS_PAID=

# The site's public address, used in checkout return links and emails.
# Blank uses whatever host the request came in on.
PUBLIC_BASE_URL=

# =============================================================
# EMAIL (Resend — resend.com)
# -------------------------------------------------------------
# Sends the access code after subscribing, and again on "Lost your code?".
# Blank RESEND_API_KEY: emails are printed in the server log instead.
# EMAIL_FROM must be on a domain verified in Resend (qfworkai.com). Until then
# use onboarding@resend.dev, which only delivers to your own Resend address.
# =============================================================
RESEND_API_KEY=
EMAIL_FROM=QFwork.ai <hello@qfworkai.com>

# Support endpoints (/api/admin: stats, subscriptions, free codes, offer
# links for WhatsApp, export). Blank = disabled. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Optional: overridden automatically by most hosting platforms.
PORT=3000

# For automated email sending trial code
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Hiring tokens for the hiring page
# Issue a batch of 25:
#   node -e "for(let i=0;i<25;i++)console.log('QFHIRE-'+require('crypto').randomBytes(3).toString('hex'))"
HIRING_TOKENS=
HIRING_TEST_TOKEN=

# Where the token→candidate mapping is kept.
# Defaults to hiring-sessions.json next to server.js.
HIRING_SESSIONS_STATE=

# Where to send the reports after candidates finish the ai interview
MANAGER_EMAIL=

# Maximum length of a hiring interview, in seconds. Tavus bills per minute,
# so this is the primary cost control for the hiring flow.
TAVUS_HIRE_MAX_SECONDS=600